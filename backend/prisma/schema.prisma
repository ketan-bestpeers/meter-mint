// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String       @id @default(uuid())
  name      String
  apiKey    String       @unique
  planId    String
  plan      Plan         @relation(fields: [planId], references: [id])
  events    UsageEvent[]
  aggregates Aggregate[]
  createdAt DateTime     @default(now())
}

model Plan {
  id               String         @id @default(uuid())
  name             String         // "Free", "Pro"
  includedQuantity Int            // 100 or 1000
  allowOverage     Boolean        // false for Free, true for Pro
  overagePrice     Float          // 0.00 or 0.02
  basePrice        Float          // 0.00 or 20.00
  organizations    Organization[]
}

model Meter {
  id         String      @id @default(uuid())
  name       String      @unique // e.g., "api_calls"
  aggregates Aggregate[]
}

model UsageEvent {
  id             String       @id @default(uuid())
  eventId        String       // Client-supplied deduplication ID
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  meterName      String
  quantity       Int
  timestamp      DateTime
  processedAt    DateTime     @default(now())

  @@unique([organizationId, eventId])
}

model Aggregate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  meterId        String
  meter          Meter        @relation(fields: [meterId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  totalQuantity  Int          @default(0)

  @@unique([organizationId, meterId, periodStart, periodEnd])
}
